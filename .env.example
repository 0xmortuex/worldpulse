# worldpulse environment
#
# Copy to .env and fill in what you have. NOTHING here is required: every
# key-gated panel degrades to a "key not configured" state, and the app runs
# end to end with this file empty.
#
# Variables prefixed VITE_ are inlined into the client bundle and are PUBLIC.
# Everything else is read only by the Cloudflare Worker in /proxy and must
# never be given a VITE_ prefix.

# --- server-side only (read by the Worker) ---

# congress.gov API v3 — free, https://api.congress.gov/sign-up/
CONGRESS_GOV_KEY=

# UN Comtrade — free tier, 500 calls/day, https://comtradedeveloper.un.org/
# Must be served from the Worker cache; do not fetch per visitor.
COMTRADE_KEY=

# US Energy Information Administration — free, https://www.eia.gov/opendata/
EIA_KEY=

# They Vote For You (Australia) — https://theyvoteforyou.org.au/help/data
THEYVOTEFORYOU_KEY=

# OpenSanctions — optional. CC BY-NC 4.0: usable by this project only while it
# stays non-commercial. OFAC and the EU consolidated list are the primary
# sanctions sources and need no key.
OPENSANCTIONS_KEY=

# Ember — electricity generation and carbon intensity. Free key by request,
# https://ember-energy.org/data/ . CC BY 4.0.
EMBER_API_KEY=

# NASA FIRMS — thermal anomalies (VIIRS/MODIS). Free MAP_KEY,
# https://firms.modaps.eosdis.nasa.gov/api/area/ . 5000 transactions/10min.
#
# What this data IS: satellite-detected thermal anomalies at a stated pixel
# footprint. What it is NOT: strikes, shelling, or combat. A fire pixel is a
# fire pixel, and its coordinate precision is bound to the sensor's resolution —
# plotting one at six decimals would read as a strike location.
FIRMS_MAP_KEY=

# --- client-side (public, inlined into the bundle) ---

# exchangerate.host — optional fallback for currencies Frankfurter (ECB,
# keyless) does not cover.
VITE_EXCHANGERATE_HOST_KEY=

# --- tooling ---

# Origin used by `npm run probe` when recording CORS posture.
PROBE_ORIGIN=https://worldpulse.pages.dev
