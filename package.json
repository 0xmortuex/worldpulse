{
  "name": "worldpulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "predev": "node scripts/preflight.mjs",
    "prebuild": "node scripts/preflight.mjs",
    "pretest": "node scripts/preflight.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "probe": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/probe-sources.mjs",
    "test": "node scripts/run-tests.mjs",
    "attribution": "node scripts/gen-attribution.mjs",
    "verify": "npm run build && node scripts/bundle-budget.mjs && node scripts/verify-render.mjs",
    "audit": "npx tsx scripts/doc-tree-audit.mjs",
    "check:deploy": "node scripts/check-deploy-gate.mjs",
    "mutate": "node scripts/mutation-check.mjs"
  },
  "dependencies": {
    "globe.gl": "^2.46.1",
    "i18n-iso-countries": "^7.14.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "playwright": "^1.62.1",
    "ts-analyzer": "npm:typescript@5.9.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
